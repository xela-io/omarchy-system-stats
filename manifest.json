{
  "schemaVersion": 1,
  "id": "xela.system-stats",
  "name": "System Stats",
  "version": "1.0.0",
  "author": "xela",
  "license": "MIT",
  "description": "Configurable CPU/GPU/RAM bar widget with grouped system details.",
  "kinds": ["bar-widget"],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "System Stats",
    "description": "CPU/GPU with optional RAM; details and preferences in popup",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showCpu": true,
      "showGpu": true,
      "showRam": false,
      "refreshInterval": 2000
    },
    "schema": [
      { "key": "showCpu", "type": "boolean", "label": "CPU in bar", "defaultValue": true },
      { "key": "showGpu", "type": "boolean", "label": "GPU in bar", "defaultValue": true },
      { "key": "showRam", "type": "boolean", "label": "RAM in bar", "defaultValue": false },
      { "key": "refreshInterval", "type": "integer", "label": "Refresh interval (ms)", "min": 1000, "max": 5000, "step": 1000, "defaultValue": 2000 }
    ]
  }
}
